{
  "name": "Growth",
  "short_name": "Growth",
  "description": "Daily engineering briefs, quizzes, prep, jobs and captures from your second-brain vault",
  "start_url": "./#/today",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#152038",
  "theme_color": "#152038",
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Today's rung",
      "short_name": "Rung",
      "url": "./#/rung",
      "icons": [
        {
          "src": "icons/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Review cards",
      "short_name": "Review",
      "url": "./#/learn/review",
      "icons": [
        {
          "src": "icons/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Story drill",
      "short_name": "Drill",
      "url": "./#/prep/drill",
      "icons": [
        {
          "src": "icons/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Quick capture",
      "short_name": "Capture",
      "url": "./#/capture",
      "icons": [
        {
          "src": "icons/icon-192.png",
          "sizes": "192x192"
        }
      ]
    }
  ],
  "share_target": {
    "action": "./share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "media",
          "accept": [
            "image/*"
          ]
        }
      ]
    }
  }
}
